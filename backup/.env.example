# Supabase database connection string
# Get from: Dashboard > Settings > Database > Connection string URI
# Use the direct connection port (5432), NOT the pooler (6543).
# pg_dump needs a direct connection, not transaction-pooled.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@db.<project-ref>.supabase.co:5432/postgres

# Where backup files are stored on disk
BACKUP_DIR=/var/backups/academic-service

# Retention: how many daily and weekly backups to keep
RETENTION_DAILY=3
RETENTION_WEEKLY=4

# Day of week for weekly promotion (0=Sunday, 1=Monday, ..., 6=Saturday)
WEEKLY_DAY=0
